{
  "name": "poc-artifact-store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Extend-owned artifact store: serverless API, MCP tools, and viewer",
  "scripts": {
    "build": "exbuild src/presentation/lambda/index.ts --skinny --reset --minify --keep-names=true --node 22",
    "synth": "pnpm build && ./node_modules/.bin/cdk synth -q",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ddb:start": "dynamo-local database start -p 8000"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "3.1068.0",
    "@aws-sdk/client-s3": "3.1068.0",
    "@aws-sdk/client-secrets-manager": "3.1068.0",
    "@aws-sdk/lib-dynamodb": "3.1068.0",
    "@extend/repo-toolkit": "2.8.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@types/aws-lambda": "8.10.152",
    "@types/node": "22.10.5",
    "aws-cdk": "2.1140.0",
    "aws-cdk-lib": "2.266.0",
    "constructs": "10.5.0",
    "esbuild": "0.25.12",
    "extend-cdk-lib": "11.46.1",
    "jose": "6.2.12",
    "tsx": "4.23.0",
    "typescript": "5.7.3",
    "vitest": "5.0.2",
    "zod": "4.6.5"
  }
}
